<Window x:Class="OpenDisplay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDisplay Windows Receiver"
        Width="1000"
        Height="650"
        Background="Black">

    <Grid Background="Black">

        <Image
            x:Name="VideoImage"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <TextBlock
            x:Name="StatusText"
            Text="Aguardando conexão..."
            Foreground="White"
            FontSize="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Window>